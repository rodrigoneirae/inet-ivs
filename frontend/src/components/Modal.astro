---
interface Props {
  id: string;
  title: string;
  description?: string;
}

const { id, title, description = '' } = Astro.props;
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-description`}
  class="m-auto max-h-[min(90dvh,48rem)] w-[min(calc(100%_-_2rem),40rem)] overflow-hidden rounded-2xl border border-line bg-surface p-0 text-ink shadow-pop backdrop:bg-slate-950/60"
>
  <div class="flex max-h-[min(90dvh,48rem)] flex-col">
    <header class="flex shrink-0 items-start gap-4 border-b border-line px-5 py-5 sm:px-6">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-primary-soft text-primary-ink" aria-hidden="true">
        <svg class="size-5" viewBox="0 0 24 24"><use href="#icon-info"></use></svg>
      </span>
      <div class="min-w-0 flex-1">
        <h2 id={`${id}-title`} class="text-lg font-semibold leading-6 text-ink">{title}</h2>
        <p id={`${id}-description`} class="mt-1 text-sm leading-relaxed text-ink-muted">{description}</p>
      </div>
      <form method="dialog">
        <button class="icon-btn size-9" type="submit" aria-label="Cerrar ventana">
          <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-cerrar"></use></svg>
        </button>
      </form>
    </header>
    <div id={`${id}-content`} class="min-h-0 overflow-y-auto px-5 py-5 sm:px-6">
      <slot />
    </div>
    <footer class="flex shrink-0 justify-end border-t border-line bg-surface-muted px-5 py-4 sm:px-6">
      <slot name="actions">
        <form method="dialog"><button class="btn btn-secondary" type="submit">Cerrar</button></form>
      </slot>
    </footer>
  </div>
</dialog>
