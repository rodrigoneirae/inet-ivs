# Plantilla de desarrollo: copiar a .env.dev sin sobrescribir credenciales existentes.
# No guardar credenciales reales en esta plantilla.
DJANGO_SECRET_KEY=local-development-secret-change-me
DJANGO_DEBUG=True
INVENTARIO_APP_TOKEN=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Solo para Astro local; en producción configura los orígenes HTTPS reales.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
POSTGRES_DB=inet_ivs_dev
POSTGRES_USER=inet_ivs_dev
POSTGRES_PASSWORD=local-development-password-change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
IVS_SAT_DB=IVS_SAT
IVS_SAT_HOST=192.168.0.8
IVS_SAT_PORT=5432
IVS_SAT_USER=
IVS_SAT_PASSWORD=
SQLSERVER_DB=
SQLSERVER_HOST=192.168.0.10
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
ANYMARKET_TOKEN=
ANYMARKET_ENVIRONMENT=production
ANYMARKET_PLATFORM=INET
ANYMARKET_ENABLED=false
ANYMARKET_TIME_ZONE=America/Santiago
INFORMAT_TOKEN_PRODUCTOS=
INFORMAT_TOKEN_TTL=86400
INFORMAT_TIMEOUT=15
# URL de autenticación SSI entregada por Informat; no es la URL base de consumo.
URLTOKEN=
# Parámetros cifrados entregados por Informat, no URLs.
EMPRUT=
CONID=
APLID=
WSPRODUCTOSVENTAS=
WSCOMERCIAL=
# HTTP permitido únicamente en desarrollo.
URL_WSCOMERCIAL=http://192.168.0.10/iws16_inversierra_test/rest/wscomercial
URL_WSPRODUCTOSVENTAS=http://192.168.0.10/iws16_inversierra_test/rest/wsproductosventas
# Referencia: estos endpoints aún no son consumidos por el código.
URL_WSEXISTENCIAS=http://192.168.0.10/iws16_inversierra_test/rest/wsexistencias
URL_WSRECEPCION=http://192.168.0.10/iws16_inversierra_test/rest/wsrecepcion
INET_PEDIDO_DOCUMENTO=771
INET_PEDIDO_BODEGA=10
INET_PEDIDO_SUCURSAL=1
INET_PEDIDO_LISTA=1
INET_PEDIDO_CONDICION=0
INET_PEDIDO_VENDEDOR=85644700
INET_PEDIDO_CLIENTE=85644700
INET_RECAUDACION_EQUIPO=1
INET_RECAUDACION_CAJERO=0
INET_RECAUDACION_FORMA_PAGO=0
CATALOGO_SOURCE_DIR=/mnt/catalogo_web
CATALOGO_STORAGE_ROOT=/var/lib/inet-ivs/catalogo
CATALOGO_TIME_ZONE=America/Santiago
# Cola compatible de pedidos I-NET: activar solo tras validar la integración.
PEDIDOS_INET_ENABLED=false
PEDIDOS_INET_DOCUMENTOS_PERMITIDOS=
